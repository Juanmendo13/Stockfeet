# Copy to .env and adjust paths.
# Lc0 is GPL-3.0-or-later — see NOTICE. Download from https://lczero.org/play/download/

STOCKFEET_LC0_PATH=C:\path\to\lc0.exe
# Optional: explicit network weights file (.pb.gz / .onnx). If empty, lc0 uses its default.
STOCKFEET_LC0_WEIGHTS=

# Thinking time per engine move (milliseconds)
STOCKFEET_MOVETIME_MS=1000

# Optional LLM coach (OpenAI-compatible). Leave empty for built-in rule-based coach.
STOCKFEET_OPENAI_API_KEY=
STOCKFEET_OPENAI_BASE_URL=https://api.openai.com/v1
STOCKFEET_OPENAI_MODEL=gpt-4o-mini
